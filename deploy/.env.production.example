# Public DNS name pointed at this VPS. Do not include http:// or https://.
APP_DOMAIN=ddt.example.com

MYSQL_DATABASE=ddt
MYSQL_USER=ddt_user
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

EWS_SERVER=owa.mos.ru
EWS_AUTH_TYPE=NTLM
EWS_SERVICE_ENDPOINT=
EWS_VERIFY_MAX_ATTEMPTS=3
EWS_VERIFY_RETRY_DELAY_SECONDS=1.0
EWS_TIMEZONE=Europe/Moscow

# Generate once and never rotate without re-encrypting saved EWS credentials:
# openssl rand 32 | openssl base64 -A | tr '+/' '-_'
EWS_CREDENTIALS_KEY=replace-with-a-fernet-key
EWS_SESSION_TTL_HOURS=24
EWS_REMEMBER_TTL_DAYS=30

EWS_NOTIFICATION_MODE=pull
EWS_NOTIFICATION_STREAM_TIMEOUT=1
EWS_NOTIFICATION_POLL_INTERVAL=15
EWS_NOTIFICATION_PULL_TIMEOUT=10
