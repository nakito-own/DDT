          "content": {
            "size": 70258,
            "mimeType": "application/javascript",
            "compression": 47496,
            "text": "Type.registerNamespace(\"_ze\");_ze.Strings=function(){};_ze.Strings.A=\"Рожица в холодном поту\";_ze.Strings.B=\"Жирная стрелка влево\";_ze.Strings.C=\"камера фотография фото\";_ze.Strings.D='Идеограмма в круге \"преимущество\"';_ze.Strings.E=\"-\";_ze.Strings.F=\"Выноска реплики\";_ze.Strings.G=\"сонливость усталость зевок\";_ze.Strings.H=\"Кухня\";_ze.Strings.I=\"19:00 7:00 ужин\";_ze.Strings.J=\"Церковь\";_ze.Strings.K='Идеограмма в круге \"поздравление\"';_ze.Strings.L=\"Танабата\";_ze.Strings.M=\"Нос\";_ze.Strings.N=\"Ангелок\";_ze.Strings.O=\"телец зодиак\";_ze.Strings.P=\"свадьба брак церковь\";_ze.Strings.Q=\"разбитое сердце скорбь печаль горе\";_ze.Strings.R=\"Спагетти\";_ze.Strings.S=\"Драгоценный камень\";_ze.Strings.T=\"Чоканье пивными кружками\";_ze.Strings.U=\"Завод\";_ze.Strings.V=\"-\";_ze.Strings.W=\"0:00 12:00 полночь полдень обед\";_ze.Strings.X=\"Массаж лица\";_ze.Strings.Y=\"Лев\";_ze.Strings.Z=\"Красный треугольник, направленный вниз\";_ze.Strings.a=\"-\";_ze.Strings.b=\"кленовый лист\";_ze.Strings.c=\"инопланетянин нло\";_ze.Strings.d=\"-\";_ze.Strings.e=\"-\";_ze.Strings.f=\"волна доска для серфинга доски для серфинга серфингист серфингисты серфинг\";_ze.Strings.g=\"корова му\";_ze.Strings.h=\"чертенок фея Локи лепрекон\";_ze.Strings.i=\"печенье выпечка еда сладости\";_ze.Strings.j=\"-\";_ze.Strings.k=\"Заварной крем\";_ze.Strings.l=\"-\";_ze.Strings.m=\"спокойствие\";_ze.Strings.n=\"водолей зодиак\";_ze.Strings.o=\"тост пиво алкоголь\";_ze.Strings.p=\"Жирный знак деления\";_ze.Strings.q=\"Голова свиньи\";_ze.Strings.r=\"Оптический диск\";_ze.Strings.s=\"зерно рассада насаждение\";_ze.Strings.t=\"Телефонная трубка\";_ze.Strings.u=\"шприц укол игла\";_ze.Strings.v=\"Ухмыляющаяся рожица\";_ze.Strings.w=\"-\";_ze.Strings.x=\"Направленный вправо указательный палец, белый, внешняя сторона ладони\";_ze.Strings.y=\"победа приз чемпионы чемпион\";_ze.Strings.z=\"Стул\";_ze.Strings.BA=\"Символ сна\";_ze.Strings.BB=\"-\";_ze.Strin