            "text": "Type.registerNamespace(\"_ucs\");_ucs.M=function(){};_ucs.M.A=\"Поиск в календаре группы\";_ucs.M.B=\"Превышено время поиска.\";_ucs.M.C=\"Выполнить поиск\";_ucs.M.D=\"{0}–{1}\";_ucs.M.E=\"{0}–{1}\";_ucs.M.F=\"Отменить поиск\";_ucs.M.G=\"Поиск\";_ucs.M.H=\"Поиск в календаре\";_ucs.M.I=\"Поиск людей\";_ucs.M.J=\"Открыть календарь\";_ucs.M.K=\"Активировать текстовое поле поиска\";_ucs.M.L='Совпадений в разделе \"Люди\" нет';_ucs.M.M=\"В этом месяце\";_ucs.M.N=\"В следующем месяце\";_ucs.M.O=\"Закрыть поиск\";_ucs.M.P=\"Ключевое слово:\";_ucs.M.Q=\"Повторяющееся\";_ucs.M.R=\"Отмена\";_ucs.M.S=\"Не удалось развернуть повторения для этого собрания.\";_ucs.M.T=\"Поиск не дал результатов.\";_ucs.M.U=\"Нет даты окончания\";_ucs.M.V=\"Идет загрузка...\";_ucs.M.W=\"В прошлом месяце\";_ucs.M.X=\"Поле поиска календаря. Введите запрос и нажмите клавишу ВВОД\";_ucs.M.Y=\"Окончание: {0}\";_ucs.M.Z=\"Весь день\";_ucs.M.a=\"Произошла ошибка во время поиска. Повторите попытку.\";_ucs.M.b=\"Ничего не найдено.\";_ucs.M.c=\"Поиск\";_ucs.M.d=\"{0}\";_ucs.M.e=\"Поиск в календаре\""
