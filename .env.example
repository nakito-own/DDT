MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ddt
MYSQL_USER=ddt_user
MYSQL_PASSWORD=ddt_password

DB_HOST=mysql
DB_PORT=3308
DB_NAME=ddt
DB_USER=ddt_user
DB_PASSWORD=ddt_password

BACKEND_PORT=3000
FRONTEND_PORT=8080

API_URL=http://localhost:3000

EWS_SERVER=owa.mos.ru
# NTLM for on-prem Exchange; leave empty to let exchangelib auto-detect
EWS_AUTH_TYPE=NTLM
# Optional full URL override, e.g. https://owa.mos.ru/EWS/Exchange.asmx
EWS_SERVICE_ENDPOINT=
EWS_VERIFY_MAX_ATTEMPTS=3
EWS_VERIFY_RETRY_DELAY_SECONDS=1.0
# HTTP timeouts (seconds) and concurrency — prevents hung login when EWS pool is exhausted
EWS_CONNECT_TIMEOUT_SECONDS=15
EWS_READ_TIMEOUT_SECONDS=60
EWS_POOL_MAXSIZE=8
EWS_THREAD_POOL_SIZE=12
EWS_MAX_CONCURRENT_OPERATIONS=6
EWS_TIMEZONE=Europe/Moscow
EWS_CREDENTIALS_KEY=
EWS_SESSION_TTL_HOURS=24
EWS_REMEMBER_TTL_DAYS=30

EWS_USERNAME=
EWS_PASSWORD=
EWS_EMAIL=

# EWS notification relay: pull (default, safe) or streaming
EWS_NOTIFICATION_MODE=pull
EWS_NOTIFICATION_STREAM_TIMEOUT=1
EWS_NOTIFICATION_POLL_INTERVAL=15
EWS_NOTIFICATION_PULL_TIMEOUT=10

GOOGLE_SHEETS_SPREADSHEET_ID=1BNbGKCTTia0DQiM01AP1FYQe0paywTen56AQgCpz-tw
GOOGLE_SHEETS_SHEET_NAME=Заявки
# Path to the service account JSON key (preferred). Do not commit this file.
GOOGLE_SHEETS_CREDENTIALS_PATH=secrets/google-sheets.json
# Alternatively paste the JSON key as a single line.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_CACHE_TTL_SECONDS=60
